/*groupby*/

select* from emp;
select avg(salary),department from emp group by department;
select max(salary),department from emp group by department;
select count(*),department from emp group by department;
select count(*),department from emp group by department having count(*)>1;
select avg(salary),department from emp group by department having avg(salary)>45000;

/*joins*/

create table dept(dept_id int,department varchar(30),manager varchar(50));
insert into dept(dept_id,department,manager)
values
(1,"IT","Suresh"),
(2,"HR","Meena"),
(3,"Sales","Kumar");
select * from dept;
select emp.e_name,dept.manager from dept inner join emp on emp.Department=dept.department;
select emp.e_name,dept.manager from dept left join emp on emp.Department=dept.department;
select emp.e_name,dept.manager from dept right join emp on emp.Department=dept.department;
select emp.e_name,dept.manager from dept left join emp on emp.Department=dept.department where dept.dept_id is null;
select emp.e_name,dept.department,dept.manager from dept left join emp on emp.Department=dept.department
union
select emp.e_name,dept.department,dept.manager from dept right join emp on emp.Department=dept.department;
